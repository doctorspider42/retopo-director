// Generated into the build tree by CMake: the executable's icon, so Explorer,
// shortcuts and the taskbar show the mark before the window has even opened,
// and the version Windows reports in the file's properties.

#include <winver.h>

1 ICON "@RD_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@RD_BUILD_NUMBER@
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@RD_BUILD_NUMBER@
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "doctorspider42"
            VALUE "FileDescription",  "PS2 Retopo Director"
            VALUE "FileVersion",      "@PROJECT_VERSION@.@RD_BUILD_NUMBER@"
            VALUE "InternalName",     "retopo-director"
            VALUE "LegalCopyright",   "Apache License 2.0"
            VALUE "OriginalFilename", "retopo-director.exe"
            VALUE "ProductName",      "PS2 Retopo Director"
            VALUE "ProductVersion",   "@PROJECT_VERSION@ build @RD_BUILD_NUMBER@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
